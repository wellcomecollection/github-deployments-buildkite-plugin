#!/bin/bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/../lib/plugin.bash"

# A plugin's command hook replaces the step's own command, the way the docker
# plugin runs yours inside a container. In wrapper mode the step has a real
# command and this has to run it, or it never runs at all.
if wrapping_command; then
  if [ -z "${BUILDKITE_COMMAND:-}" ]; then
    echo "wrap is true but this step has no command to wrap" >&2
    exit 1
  fi

  # A fresh shell, matching the agent's own default of bash -e -c. Running it
  # here instead would report success for a multi-line command whose earlier
  # line failed, and would impose this hook's set -u on it.
  command_status=0
  /bin/bash -e -c "${BUILDKITE_COMMAND}" || command_status=$?
  exit ${command_status}
fi

run_plugin command
